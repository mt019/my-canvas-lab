  "chronologyMain": [
    {
      "year": "1467",
      "region": "日本",
      "event": "應仁之亂爆發，此後全國內亂約一世紀（戰國時代）。[^c-onin]武士的行為規範在實戰環境裡成形。"
    },
    {
      "year": "1543",
      "region": "對外",
      "event": "葡萄牙人漂流到種子島，火繩槍（鐵砲）傳入；[^c-teppo]1549 年沙勿略抵鹿兒島，基督教開始傳教。[^c-xavier]"
    },
    {
      "year": "1590",
      "region": "日本",
      "event": "豐臣秀吉統一全國，戰國內亂收束；[^c-hideyoshi]1592、1597 兩度出兵朝鮮，失敗。[^c-bunroku]"
    },
    {
      "year": "1600",
      "region": "日本",
      "event": "關原之戰，德川家康取得全國霸權。[^c-sekigahara]同年荷蘭船漂著日本，此後荷蘭人取得貿易許可。[^c-liefde]"
    },
    {
      "year": "1603",
      "region": "日本",
      "event": "德川家康受任征夷大將軍，在江戶（今東京）開設幕府。德川家世襲將軍十五代。[^c-edo-bakufu]"
    },
    {
      "year": "1609",
      "region": "對外",
      "event": "薩摩藩島津氏出兵琉球。[^c-shimazu]琉球此後對明清照樣朝貢、對薩摩實質從屬，維持兩屬狀態近三百年。[^c-ryozoku]"
    },
    {
      "year": "1635–41",
      "region": "對外",
      "event": "禁止日本人海外渡航（1635）、驅逐葡萄牙船（1639）、荷蘭商館遷入長崎出島（1641）——後世稱「鎖國」。[^c-sakoku]實際留了四個窗口：長崎對荷蘭（VOC）與中國商船，對馬對朝鮮，薩摩對琉球，松前對蝦夷地。"
    },
    {
      "year": "1774",
      "region": "日本",
      "event": "杉田玄白等譯《解體新書》出版。[^c-kaitai]經長崎荷蘭語書籍傳入的西學（蘭學）在醫學、天文領域成形。"
    },
    {
      "year": "1853",
      "region": "對外",
      "event": "美國培里艦隊駛入江戶灣（黑船來航），要求開國。幕府權威從此動搖。[^c-kurofune]"
    },
    {
      "year": "1854・1858",
      "region": "對外",
      "event": "日美和親條約開國；[^c-washin]安政五國條約承認領事裁判權、喪失關稅自主。[^c-ansei]修改不平等條約成為此後半世紀日本外交的主題。[^c-joyaku-kaisei]"
    },
    {
      "year": "1867–68",
      "region": "日本",
      "event": "大政奉還、明治維新。[^c-taisei-hokan]此後廢身分制、廢藩置縣（1871），武士階層消失。[^c-haihan]"
    },
    {
      "year": "1874",
      "region": "台灣",
      "event": "牡丹社事件：明治政府以琉球漂流民被殺為由出兵台灣南部，是明治日本第一次對外用兵。[^c-taiwan-shuppei]"
    },
    {
      "year": "1879",
      "region": "琉球",
      "event": "琉球處分：廢琉球藩、設沖繩縣，兩屬狀態終結；清國抗議未果。[^c-ryukyu-shobun]"
    },
    {
      "year": "1889",
      "region": "日本",
      "event": "大日本帝國憲法發布，天皇主權下的立憲體制成立。[^c-teikoku-kenpo]"
    },
    {
      "year": "1894–95",
      "region": "台灣",
      "event": "甲午戰爭（日清戰爭）。[^c-nisshin]馬關條約割讓台灣、澎湖，台灣進入日本統治五十年。[^c-shimonoseki]"
    },
    {
      "year": "1904–05",
      "region": "對外",
      "event": "日俄戰爭。[^c-nichiro]戰後取得南滿權益，1910 年併吞韓國。[^c-kankoku]"
    },
    {
      "year": "1914",
      "region": "對外",
      "event": "第一次世界大戰：日本對德宣戰，佔領山東的德國租借地與南洋群島。[^c-wwi]"
    },
    {
      "year": "1931・1937",
      "region": "對外",
      "event": "滿洲事變（九一八）；[^c-manshu]1937 年蘆溝橋事變後中日全面戰爭。[^c-nicchu]"
    },
    {
      "year": "1941",
      "region": "對外",
      "event": "美國對日石油禁運（8 月）；12 月日軍偷襲夏威夷珍珠港的美國太平洋艦隊，太平洋戰爭開始。[^c-taiheiyo]"
    },
    {
      "year": "1942",
      "region": "對外",
      "event": "日軍攻佔荷屬東印度（今印尼）：2 月空降蘇門答臘巨港油田、爪哇海海戰，3 月荷軍在爪哇投降。[^c-ranin]奪取蘭印石油是對美開戰的直接目標；這片殖民地正是荷蘭從 VOC 時代經營起來的。1945 年日本投降後，印尼宣布獨立。"
    },
    {
      "year": "1945",
      "region": "日本",
      "event": "廣島、長崎原爆，日本投降。占領期改革：新憲法（1946 年公布）、民法家制度廢止。[^c-kazoku-seido]"
    }
  ],
  "chronologyConcept": [
    {
      "year": "1651",
      "region": "歐洲",
      "event": "霍布斯《利維坦》出版。社會契約論把個人放在國家之前——「權利的個人主義」的起點之一。"
    },
    {
      "year": "1789",
      "region": "歐洲",
      "event": "法國大革命。《人權和公民權宣言》宣告人生而自由、權利平等。"
    },
    {
      "year": "1820 年代",
      "region": "歐洲",
      "event": "individualisme 一詞在法國出現，最初是貶義：保守派（de Maistre 一系）與聖西門派都拿它批評社會的原子化。"
    },
    {
      "year": "1859",
      "region": "歐洲",
      "event": "彌爾《論自由》出版，主張 individuality 是幸福的要素之一——「個性的個人主義」的代表作。"
    },
    {
      "year": "1872",
      "region": "東亞",
      "event": "中村正直將《論自由》譯成《自由之理》，individual 譯作「其人自己」「人各自己」。"
    },
    {
      "year": "1875",
      "region": "東亞",
      "event": "福澤諭吉《文明論之概略》把 individual 譯作「獨一個人」。19 世紀末「個人」這個譯法定型。"
    },
    {
      "year": "1902",
      "region": "東亞",
      "event": "梁啟超自日語把「個人」引入中文（〈論政府與人民之權限〉）。"
    },
    {
      "year": "1915",
      "region": "東亞",
      "event": "陳獨秀〈東西民族根本思想之差異〉：「西方民族以個人為本位，東方民族以家族為本位」。"
    }
  ],
  "statusOrder": {
    "intro": "德川時代的統治集團是軍隊。徵稅與審判都由武士執行；武士身分世襲，日本沒有科舉。同時期的明清中國與朝鮮由科舉出身的文人官僚統治，兩種統治階層的自我形象相反：日本諺語說「花要做櫻花、人要當武士」，中國諺語說「好鐵不打釘、好人不當兵」。",
    "layers": [
