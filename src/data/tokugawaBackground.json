        "desc": "農民與工商業者。納稅、服從審判；僧侶與公家在此秩序之外另成一格。"
      }
    ]
  },
  "ieVsZongzu": {
    "intro": "日本近世的「家」（イエ，i-e）與漢人宗族是兩種完全不同的組織。宗族是父系血緣集團；イエ的核心是代代經營的「家業」，性質接近法人——重點在這個經營體的存續，由誰來承擔反而其次。",
    "rows": [
      {
        "aspect": "組織的性質",
        "cn": "父系血緣集團。修族譜、序行輩，把每個男性定位在從祖先數下來的世系上。",
        "jp": "經營特定「家業」的存續體，類似法人。家名、家產、家業一體傳承。"
      },
      {
        "aspect": "繼承",
        "cn": "諸子均分父親的財產。",
        "jp": "單獨繼承。家產屬於家本身，原則上不可分割。"
      },
      {
        "aspect": "姓",
        "cn": "個人終身不改，女性婚後仍用本家姓。",
        "jp": "姓（苗字、商號）屬於家；戶主冠用，婿養子改從妻家之姓。"
      },
      {
        "aspect": "沒有男嗣時",
        "cn": "過繼，原則上限同宗族內。",
        "jp": "招婿（婿養子）或收養一對男女（夫婦養子），不限血緣，能承家業即可。"
      },
      {
        "aspect": "個人的位置",
        "cn": "生來在族譜上有確定位置，認同與生俱來。",
        "jp": "承擔當下的「名跡」（名號與角色）；離婚、再婚、收養造成的身分變動視為常態。"
      }
    ]
  },
  "glossary": [
    {
