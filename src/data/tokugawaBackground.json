      "terms": [
        {
          "term": "幕府",
          "reading": "ばくふ",
          "def": "武家政權的政府。「幕」原指出征將軍的軍帳。德川幕府 1603 年由德川家康開設於江戶，1867 年大政奉還為止。[^g-bakufu]",
          "roman": "bakufu"
        },
        {
          "term": "征夷大將軍",
          "reading": "せいいたいしょうぐん",
          "def": "武家政權的最高首長，名義上由天皇任命。德川家世襲十五代。[^g-seii-taishogun]",
          "roman": "seii taishōgun"
        },
        {
          "term": "大名",
          "reading": "だいみょう",
          "def": "領地規模達一定標準的地方領主，德川時代約二百六十家；各自統治領國，對將軍負軍役義務。[^g-daimyo]",
          "roman": "daimyō"
        },
        {
          "term": "藩",
          "reading": "はん",
          "def": "大名的領國與統治組織。1871 年廢藩置縣，改由中央政府直轄。[^g-han]",
          "roman": "han"
