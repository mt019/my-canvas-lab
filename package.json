{
  "name": "vite-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "node scripts/install-git-hooks.mjs",
    "verify:policy": "npm run validate:fonts && npm run validate:tokens && npm run validate:colors && npm run validate:floating && npm run validate:copy && npm run validate:math && npm run validate:cases && npm run validate:ccdataset && npm run validate:pdfproxy && npm run validate:shell && npm run validate:publicpaths && npm run validate:tabroutes && npm run validate:userscripts && npm run validate:synced",
    "build": "npm run verify:policy && vite build && npm run prerender && npm run validate:prerender && npm run sitemap",
    "verify:push": "npm run verify:policy",
    "verify:gates": "npm run verify:policy && vite build --outDir node_modules/.verify-dist --emptyOutDir --logLevel warn",
    "preprerender": "playwright install chromium",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "validate:cases": "node scripts/validate-case-query.mjs",
 "validate:ccdataset": "node scripts/validate-cc-dataset.mjs",
    "validate:pdfproxy": "node scripts/validate-pdf-proxy.mjs",
    "validate:prerender": "node scripts/validate-prerender.mjs",
    "validate:shell": "node scripts/validate-shell-chrome.mjs",
    "validate:publicpaths": "node scripts/validate-public-paths.mjs",
    "validate:fonts": "node scripts/validate-font-coverage.mjs",
    "fonts:rebuild": "node scripts/rebuild-font-subsets.mjs",
    "validate:tokens": "node scripts/validate-design-tokens.mjs",
    "validate:colors": "node scripts/validate-color-system.mjs",
    "validate:floating": "node scripts/validate-floating-surfaces.mjs",
    "validate:copy": "node scripts/validate-ui-copy.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate:math": "node scripts/validate-math-notation.mjs",
    "check:brief": "node scripts/check-brief-pages.mjs",
    "validate:tabroutes": "node scripts/validate-tab-routes.mjs",
    "validate:userscripts": "node scripts/validate-userscripts.mjs",
    "report:userscripts": "node scripts/userscript-reach.mjs",
    "validate:synced": "node scripts/validate-synced-content.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.1",
    "clsx": "^2.1.0",
    "katex": "^0.17.0",
    "lucide-react": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "fontkit": "^2.0.4",
    "globals": "^15.9.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
