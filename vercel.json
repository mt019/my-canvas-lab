{
  "regions": ["hnd1"],
  "git": { "deploymentEnabled": { "main": false } },
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/notes/deployment-manifest.json", "headers": { "Cache-Control": "no-store, max-age=0" }, "continue": true },
    { "src": "/constitutionalcourt", "dest": "https://cc.phenomcanvas.com/constitutionalcourt/", "status": 308 },
    { "src": "/constitutionalcourt/(.*)", "dest": "https://cc.phenomcanvas.com/constitutionalcourt/$1", "status": 308 },
    { "src": "/jirsforeignlaw", "dest": "https://judicial-translations.phenomcanvas.com/", "status": 308 },
    { "src": "/jirsforeignlaw/(.*)", "dest": "https://judicial-translations.phenomcanvas.com/", "status": 308 },
    { "src": "/legalglossary", "dest": "https://judicial-translations.phenomcanvas.com/glossary/", "status": 308 },
    { "src": "/legalglossary/(.*)", "dest": "https://judicial-translations.phenomcanvas.com/glossary/", "status": 308 },
    { "src": "/familywealth", "dest": "https://wealth.phenomcanvas.com/", "status": 308 },
    { "src": "/familywealth/(.*)", "dest": "https://wealth.phenomcanvas.com/", "status": 308 },
    { "src": "/notes", "dest": "https://phenom-notes.pages.dev/notes/" },
    { "src": "/notes/(.*)", "dest": "https://phenom-notes.pages.dev/notes/$1" },
    { "src": "/api/opentix/search", "dest": "https://search.opentix.life/search" },
    { "src": "/api/opentix-csm/(.*)", "dest": "https://csm.api.opentix.life/$1" },
    { "src": "/scripts/(.*)", "status": 404, "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
